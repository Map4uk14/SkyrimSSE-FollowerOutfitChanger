{
    "modName": "DressYourFollowers",
    "displayName": "Follower Outfit Changer",
    "minMcmVersion": 11,
    "cursorFillMode": "topToBottom",
    "pluginRequirements": [
        "DressYourFollowers.esp"
    ],
    "content": [
        {
            "type": "header",
            "text": "General"
        },
        {
            "id": "bModEnabled:General",
            "type": "toggle",
            "text": "Mod enabled",
            "help": "Master switch. When off, the overlay does nothing and outfits are no longer re-asserted.",
            "valueOptions": {
                "sourceType": "ModSettingBool"
            }
        },
        {
            "id": "iOpenKey:General",
            "type": "keymap",
            "text": "Open wardrobe hotkey",
            "help": "Key to open/close the wardrobe overlay while looking at a follower. Default F4; clear it to disable.",
            "valueOptions": {
                "sourceType": "ModSettingInt"
            }
        },
        {
            "id": "iAccent:General",
            "type": "color",
            "text": "Overlay accent color",
            "help": "Accent color for the wardrobe overlay - equipped items, highlights and the active tab. Takes effect next time the overlay opens.",
            "valueOptions": {
                "sourceType": "ModSettingInt"
            }
        },
        {
            "id": "iUiScale:General",
            "type": "slider",
            "text": "Overlay size",
            "help": "Scale of the wardrobe overlay window and text. 100% is the default; raise it if the overlay is hard to read. Takes effect next time the overlay opens.",
            "valueOptions": {
                "min": 50,
                "max": 200,
                "step": 5,
                "formatString": "{0}%",
                "sourceType": "ModSettingInt"
            }
        },
        {
            "type": "header",
            "text": "Dressed followers"
        },
        {
            "id": "iManagedList:Maintenance",
            "type": "menu",
            "text": "Dressed followers",
            "help": "Followers this mod is currently keeping dressed. The row shows the current count; open the list to see who. Read-only.",
            "valueOptions": {
                "sourceType": "ModSettingInt",
                "options": [
                    "(open menu to refresh)"
                ]
            }
        },
        {
            "type": "text",
            "text": "Re-assert outfits now",
            "help": "Immediately re-apply the saved outfit to every nearby managed follower. Use if someone looks wrong after a script-heavy event.",
            "action": {
                "type": "CallFunction",
                "form": "DressYourFollowers.esp|0xD62",
                "scriptName": "DYF_Main",
                "function": "ReassertAllLoaded"
            }
        },
        {
            "type": "text",
            "text": "Release all followers",
            "help": "Stop managing every follower. They keep what they are wearing now, but the mod no longer re-asserts it, and their original default outfit is restored behind the scenes. Use before uninstalling.",
            "action": {
                "type": "CallFunction",
                "form": "DressYourFollowers.esp|0xD62",
                "scriptName": "DYF_Main",
                "function": "ClearAllManaged"
            }
        },
        {
            "type": "header",
            "text": "Help",
            "position": 1
        },
        {
            "type": "text",
            "text": "How to use",
            "help": "Look at a follower and press the wardrobe hotkey (default F4) to open the overlay, then tick items to dress them. Requires the PrismaUI framework."
        },
        {
            "type": "text",
            "text": "Follower manager conflicts",
            "help": "If you use NFF/EFF/AFT outfit management on a follower, turn it off for that follower before dressing them here, or the two systems will fight."
        }
    ]
}
